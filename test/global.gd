extends Node

# =============================================
# 글로벌 게임 매니저 (Autoload)
# =============================================

# --- 플레이어 스탯 ---
var 최대HP: int = 100
var 현재HP: int = 100
var 최대MP: int = 50
var 현재MP: int = 50

var 레벨: int = 1
var 경험치: int = 0
var 다음레벨경험치: int = 100

var 골드: int = 0

# --- 능력 해금 상태 ---
var 더블점프_해금: bool = false
var 대쉬_해금: bool = false
var 달리기_해금: bool = false

# --- 게임 진행도 ---
var 현재스테이지: int = 1
var 체크포인트위치: Vector2 = Vector2(200, 300)
var 죽은횟수: int = 0

# --- 인벤토리 (나중에 확장 가능) ---
var 인벤토리: Array = []

# --- 시그널 (UI 업데이트용) ---
signal HP변경(현재, 최대)
signal MP변경(현재, 최대)
signal 레벨업(새레벨)
signal 골드변경(새골드)
signal 경험치변경(현재, 필요)


# =============================================
# 초기화
# =============================================
func _ready() -> void:
	print("=== Global 시스템 로드됨 ===")
	print("HP: ", 현재HP, "/", 최대HP)
	print("레벨: ", 레벨)


# =============================================
# HP 관리
# =============================================
func HP감소(데미지: int) -> void:
	현재HP -= 데미지
	if 현재HP < 0:
		현재HP = 0
	
	print("HP 감소: -", 데미지, " | 현재: ", 현재HP, "/", 최대HP)
	HP변경.emit(현재HP, 최대HP)
	
	if 현재HP <= 0:
		플레이어사망()

func HP회복(회복량: int) -> void:
	현재HP += 회복량
	if 현재HP > 최대HP:
		현재HP = 최대HP
	
	print("HP 회복: +", 회복량, " | 현재: ", 현재HP, "/", 최대HP)
	HP변경.emit(현재HP, 최대HP)

func 최대HP증가(증가량: int) -> void:
	최대HP += 증가량
	현재HP += 증가량  # 최대HP 늘어나면 현재도 회복
	print("최대HP 증가: +", 증가량, " | 새 최대HP: ", 최대HP)
	HP변경.emit(현재HP, 최대HP)


# =============================================
# MP 관리
# =============================================
func MP감소(소모량: int) -> bool:
	if 현재MP >= 소모량:
		현재MP -= 소모량
		print("MP 사용: -", 소모량, " | 현재: ", 현재MP, "/", 최대MP)
		MP변경.emit(현재MP, 최대MP)
		return true
	else:
		print("MP 부족!")
		return false

func MP회복(회복량: int) -> void:
	현재MP += 회복량
	if 현재MP > 최대MP:
		현재MP = 최대MP
	MP변경.emit(현재MP, 최대MP)


# =============================================
# 경험치 & 레벨업
# =============================================
func 경험치획득(양: int) -> void:
	경험치 += 양
	print("경험치 획득: +", 양, " | 현재: ", 경험치, "/", 다음레벨경험치)
	경험치변경.emit(경험치, 다음레벨경험치)
	
	# 레벨업 체크
	while 경험치 >= 다음레벨경험치:
		_레벨업()

func _레벨업() -> void:
	경험치 -= 다음레벨경험치
	레벨 += 1
	다음레벨경험치 = int(다음레벨경험치 * 1.5)  # 필요 경험치 50% 증가
	
	# 레벨업 보상
	최대HP증가(10)
	최대MP += 5
	현재MP = 최대MP
	
	print("★ 레벨업! 새 레벨: ", 레벨)
	레벨업.emit(레벨)
	경험치변경.emit(경험치, 다음레벨경험치)


# =============================================
# 골드
# =============================================
func 골드획득(양: int) -> void:
	골드 += 양
	print("골드 획득: +", 양, " | 총 골드: ", 골드)
	골드변경.emit(골드)

func 골드사용(양: int) -> bool:
	if 골드 >= 양:
		골드 -= 양
		print("골드 사용: -", 양, " | 남은 골드: ", 골드)
		골드변경.emit(골드)
		return true
	else:
		print("골드 부족!")
		return false


# =============================================
# 능력 해금
# =============================================
func 능력해금(능력이름: String) -> void:
	match 능력이름:
		"더블점프":
			더블점프_해금 = true
			print("★ 더블점프 해금!")
		"대쉬":
			대쉬_해금 = true
			print("★ 대쉬 해금!")
		"달리기":
			달리기_해금 = true
			print("★ 달리기 해금!")


# =============================================
# 게임 상태 관리
# =============================================
func 체크포인트저장(위치: Vector2) -> void:
	체크포인트위치 = 위치
	print("체크포인트 저장: ", 위치)

func 플레이어사망() -> void:
	죽은횟수 += 1
	print("=== 사망 ===")
	print("죽은 횟수: ", 죽은횟수)
	
	# 부활 (HP 50% 회복)
	현재HP = 최대HP / 2
	HP변경.emit(현재HP, 최대HP)
	
	# TODO: 체크포인트로 이동 or 게임오버 화면
	# get_tree().reload_current_scene()

func 게임리셋() -> void:
	현재HP = 최대HP
	현재MP = 최대MP
	경험치 = 0
	레벨 = 1
	골드 = 0
	죽은횟수 = 0
	더블점프_해금 = false
	대쉬_해금 = false
	달리기_해금 = false
	print("=== 게임 리셋 ===")


# =============================================
# 디버그용 치트
# =============================================
func 치트_무적() -> void:
	최대HP = 9999
	현재HP = 9999
	print("치트: 무적 모드")

func 치트_만렙() -> void:
	레벨 = 99
	경험치 = 0
	더블점프_해금 = true
	대쉬_해금 = true
	달리기_해금 = true
	print("치트: 만렙 + 모든 능력 해금")
